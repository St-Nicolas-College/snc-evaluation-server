{
  "kind": "collectionType",
  "collectionName": "students",
  "info": {
    "singularName": "student",
    "pluralName": "students",
    "displayName": "Student"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "student_id": {
      "type": "string",
      "unique": true
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "mappedBy": "student"
    },
    "year_level": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "assigned_teachers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::teacher.teacher",
      "inversedBy": "students"
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "students"
    },
    "overall_feedbacks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::overall-feedback.overall-feedback",
      "mappedBy": "student"
    }
  }
}
