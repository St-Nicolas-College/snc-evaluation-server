{
  "kind": "collectionType",
  "collectionName": "portfolio_entries",
  "info": {
    "singularName": "portfolio-entry",
    "pluralName": "portfolio-entries",
    "displayName": "Portfolio Entry"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "entry_type": {
      "type": "enumeration",
      "enum": [
        "educational_qualifications",
        "eligibility",
        "training_seminars",
        "research",
        "awards_recognition",
        "professional_experience",
        "loyalty",
        "evaluation",
        "corporate_social_responsibility"
      ],
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "institution": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "reference_number": {
      "type": "string"
    },
    "start_date": {
      "type": "date"
    },
    "end_date": {
      "type": "date"
    },
    "date_earned": {
      "type": "date"
    },
    "expiration_date": {
      "type": "date"
    },
    "points": {
      "type": "decimal",
      "default": 0,
      "min": 0,
      "required": true
    },
    "years_count": {
      "type": "decimal",
      "min": 0
    },
    "remarks": {
      "type": "text"
    },
    "is_current": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "school_year": {
      "type": "string"
    },
     "semester": {
      "type": "string"
    },
    "teacher": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::teacher.teacher",
      "inversedBy": "portfolio_entries",
      "required": true
    },
    "ranking_breakdowns": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faculty-ranking-breakdown.faculty-ranking-breakdown",
      "mappedBy": "portfolio_entry"
    }
  }
}
