{
  "kind": "collectionType",
  "collectionName": "portfolio_entries",
  "info": {
    "singularName": "portfolio-entry",
    "pluralName": "portfolio-entries",
    "displayName": "Portfolio Entry"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "entry_type": {
      "type": "enumeration",
      "enum": [
        "educational_attainment",
        "eligibility",
        "license",
        "certification",
        "training",
        "seminar",
        "resource_speaker",
        "research",
        "publication",
        "award",
        "professional_experience",
        "institutional_service",
        "community_service",
        "other"
      ],
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "institution": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "reference_number": {
      "type": "string"
    },
    "start_date": {
      "type": "date"
    },
    "end_date": {
      "type": "date"
    },
    "date_earned": {
      "type": "date"
    },
    "expiration_date": {
      "type": "date"
    },
    "quantity": {
      "type": "integer",
      "default": 1,
      "min": 1,
      "required": true
    },
    "years_count": {
      "type": "decimal",
      "min": 0
    },
    "verification_status": {
      "type": "enumeration",
      "enum": [
        "draft",
        "pending",
        "for_verification",
        "verified",
        "rejected",
        "needs_correction",
        "expired"
      ],
      "default": "draft",
      "required": true
    },
    "is_current": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "verified_at": {
      "type": "datetime"
    },
    "remarks": {
      "type": "text"
    },
    "faculty_portfolio": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::faculty-portfolio.faculty-portfolio",
      "inversedBy": "entries",
      "required": true
    },
    "verified_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "evidence": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::portfolio-evidence.portfolio-evidence",
      "mappedBy": "portfolio_entry"
    },
    "verification_history": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::portfolio-verification.portfolio-verification",
      "mappedBy": "portfolio_entry"
    }
  }
}
