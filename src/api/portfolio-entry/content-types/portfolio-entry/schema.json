{
  "kind": "collectionType",
  "collectionName": "portfolio_entries",
  "info": {
    "singularName": "portfolio-entry",
    "pluralName": "portfolio-entries",
    "displayName": "Portfolio Entry"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "entry_type": {
      "type": "enumeration",
      "enum": [
        "educational_attainment",
        "eligibility",
        "license",
        "certification",
        "training",
        "seminar",
        "resource_speaker",
        "research",
        "publication",
        "award",
        "professional_experience",
        "institutional_service",
        "community_service",
        "other"
      ],
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "institution": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "reference_number": {
      "type": "string"
    },
    "start_date": {
      "type": "date"
    },
    "end_date": {
      "type": "date"
    },
    "date_earned": {
      "type": "date"
    },
    "expiration_date": {
      "type": "date"
    },
    "quantity": {
      "type": "integer",
      "default": 1,
      "min": 1,
      "required": true
    },
    "years_count": {
      "type": "decimal",
      "min": 0
    },
    "remarks": {
      "type": "text"
    },
    "is_current": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "teacher": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::teacher.teacher",
      "inversedBy": "portfolio_entries",
      "required": true
    }
  }
}
