{
  "kind": "collectionType",
  "collectionName": "ranking_criteria",
  "info": {
    "singularName": "ranking-criterion",
    "pluralName": "ranking-criteria",
    "displayName": "Ranking Criterion"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "code": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "sequence": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "points": {
      "type": "decimal",
      "default": 0,
      "required": true,
      "min": 0
    },
    "points_per_item": {
      "type": "decimal",
      "min": 0
    },
    "maximum_points": {
      "type": "decimal",
      "min": 0
    },
    "minimum_quantity": {
      "type": "integer",
      "min": 0
    },
    "maximum_quantity": {
      "type": "integer",
      "min": 0
    },
    "minimum_value": {
      "type": "decimal",
      "min": 0
    },
    "maximum_value": {
      "type": "decimal",
      "min": 0
    },
    "calculation_type": {
      "type": "enumeration",
      "enum": [
        "fixed",
        "per_item",
        "range",
        "years_of_service",
        "evaluation_conversion",
        "manual"
      ],
      "default": "fixed",
      "required": true
    },
    "evidence_type": {
      "type": "enumeration",
      "enum": [
        "diploma",
        "transcript",
        "license",
        "certificate",
        "publication",
        "award",
        "employment_record",
        "community_service_record",
        "evaluation_result",
        "other"
      ]
    },
    "requires_evidence": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "is_repeatable": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::ranking-category.ranking-category",
      "inversedBy": "criteria",
      "required": true
    }
  }
}
