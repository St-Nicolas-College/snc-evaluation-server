{
  "kind": "collectionType",
  "collectionName": "portfolio_evidences",
  "info": {
    "singularName": "portfolio-evidence",
    "pluralName": "portfolio-evidences",
    "displayName": "Portfolio Evidence"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "evidence_type": {
      "type": "enumeration",
      "enum": [
        "diploma",
        "transcript",
        "license",
        "certificate",
        "publication",
        "award_document",
        "employment_record",
        "service_record",
        "community_service_record",
        "other"
      ],
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "document_number": {
      "type": "string"
    },
    "issue_date": {
      "type": "date"
    },
    "expiration_date": {
      "type": "date"
    },
    "verification_status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "verified",
        "rejected",
        "needs_correction",
        "expired"
      ],
      "default": "pending",
      "required": true
    },
    "verified_at": {
      "type": "datetime"
    },
    "remarks": {
      "type": "text"
    },
    "file": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["files", "images"]
    },
    "portfolio_entry": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::portfolio-entry.portfolio-entry",
      "inversedBy": "evidence",
      "required": true
    },
    "verified_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
